# MySQL/MariaDB connection for the api container (api/src/db.js).
# No db service in docker-compose - point these at your external DB host.
# For a DB running on the Docker host, use host.docker.internal (or the
# host's LAN IP); localhost inside the container is the container itself.
DB_HOST=192.168.12.202
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=smsgoku

# Port the Node server listens on inside the container (compose maps it out).
PORT=3000
